@page
@model AuthApp.Pages.Admin.ManageRolesModel
@{
    ViewData["Title"] = "Manage Roles";
}

<h2>Manage User Roles</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<form method="post">
    <div class="form-group">
        <label for="userSelect">Select User:</label>
        <select asp-for="SelectedUserId" class="form-control" id="userSelect">
            @foreach (var user in Model.Users)
            {
                <option value="@user.Id">@user.Email</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label for="roleSelect">Select Role:</label>
        <select asp-for="SelectedRole" class="form-control" id="roleSelect">
            @foreach (var role in Model.Roles)
            {
                <option value="@role">@role</option>
            }
        </select>
    </div>

    <button type="submit" asp-page-handler="AssignRole" class="btn btn-success">Assign Role</button>
    <button type="submit" asp-page-handler="RemoveRole" class="btn btn-danger">Remove Role</button>
</form>
